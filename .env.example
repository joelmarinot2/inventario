# Copia este archivo a .env.local y pon tus valores de Supabase.
# NUNCA pongas aquí la clave secreta (service_role). Solo la publishable.

# Panel de Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Panel de Supabase > Project Settings > API Keys > "publishable" (o "anon public")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TU_PUBLISHABLE_KEY

# OPCIONAL y SOLO en el servidor (NUNCA con prefijo NEXT_PUBLIC_, nunca en el
# navegador). Sirve únicamente para crear usuarios desde la pantalla de
# Administración > Usuarios. Si no la pones, los usuarios se crean desde el
# panel de Supabase (Authentication > Users).
# Panel de Supabase > Project Settings > API Keys > "service_role" (secret)
# SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
